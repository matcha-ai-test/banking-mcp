# Normally generated by `npm run install:mcp`. Never commit real values.
# Enable Banking Application ID: the UUID on the application's page in the Control Panel. You supply it, the installer stores it.
EB_APP_ID=your-enable-banking-application-id
# Enable Banking private key (PKCS#8 PEM) that signs API calls. Downloaded from the Control Panel; the installer reads it from --key-file and stores it here.
EB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Connection password that MCP clients present to /mcp. Generated by the installer; also written to .mcp-credentials as CONNECTION_PASSWORD.
MCP_SECRET=generated-connection-password
# Operator token that guards /auth/start. Generated by the installer; only `npm run auth:link` reads it. Never appears in .mcp-credentials.
START_TOKEN=generated-bank-link-token
# Local server URL. Set by the installer. The deployed URL lives in CLOUD_URL below and in wrangler.local.jsonc.
BASE_URL=http://127.0.0.1:8787
# Install mode (local, cloud, or both). Set by the installer.
# INSTALL_MODE=local
# Deployed Worker URL. Set by the installer after the first cloud deploy; absent in Local mode.
# CLOUD_URL=https://banking-mcp.<your-subdomain>.workers.dev
